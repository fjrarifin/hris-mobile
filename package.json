{
  "name": "hris-mobile",
  "private": true,
  "version": "1.7.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:apk:windows": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "build:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease && cd .. && npm run publish:apk",
    "build:release:windows": "npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease && cd .. && npm run publish:apk",
    "publish:apk": "node scripts/publish-apk.mjs",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.3.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/status-bar": "8.0.2",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "ionicons": "^7.0.0",
    "qrcode": "^1.5.4",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "cypress": "^13.6.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vitest": "^1.5.0",
    "vue-tsc": "^2.0.0"
  }
}
